    "test:performance-history": "node --test tests/site/performance_history.test.mjs",
    "test:performance-policy": "node --test tests/site/performance_policy.test.mjs",
    "test:performance-skip": "node --test tests/site/performance_skip.test.mjs",
    "test:performance-summary": "node --test tests/site/performance_summary.test.mjs",
    "test:quality-pulse": "node --test tests/orchestration/daily_workflow.test.mjs tests/orchestration/quality_pulse.test.mjs tests/common/dependency_posture.test.mjs",
    "test:coherence-integrity": "node --test tests/common/coherence_integrity.test.mjs",
